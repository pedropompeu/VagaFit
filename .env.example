# Copie para .env e ajuste. Nunca commite o .env.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# Banco (docker compose monta DATABASE_URL a partir destes valores)
POSTGRES_USER=vagafit
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vagafit

# Origem exata do front (JSON). Com cookie de refresh, curinga não é aceito.
CORS_ORIGINS=["http://localhost:5173"]

# Portas publicadas no host
API_PORT=8000
WEB_PORT=5173
VITE_API_URL=http://localhost:8000

# Fase 1 em diante:
# JWT_SECRET=
# IA. `fake` = provedores determinísticos, sem rede (padrão local e de teste; proibido em produção).
# EMBEDDING_PROVIDER=openai          # openai | gemini | fake
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_PROVIDER=anthropic             # anthropic | openai | gemini | fake
# ANTHROPIC_API_KEY=
# Spec: modelo barato no desenvolvimento, o melhor na demo. Sem a variável, o padrão é claude-opus-5-5.
# ANTHROPIC_LLM_MODEL=claude-haiku-5-5
# OPENAI_LLM_MODEL=gpt-4.1-mini
# Gemini (LLM e embeddings com uma chave só; endpoint compatível com OpenAI):
# GEMINI_API_KEY=
# GEMINI_LLM_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# AI_MAX_ATTEMPTS=5
# Métricas: com token, /metrics exige "Authorization: Bearer <token>" (obrigatório em produção,
# 32+ caracteres; gere com `openssl rand -hex 32`). Sem token, a rota fica aberta.
# METRICS_TOKEN=
