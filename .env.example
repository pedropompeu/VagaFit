# Copie para .env e ajuste. Nunca commite o .env.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# Banco (docker compose monta DATABASE_URL a partir destes valores)
POSTGRES_USER=vagafit
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vagafit

# Origem exata do front (JSON). Com cookie de refresh, curinga não é aceito.
CORS_ORIGINS=["http://localhost:5173"]

# Portas publicadas no host
API_PORT=8000
WEB_PORT=5173
VITE_API_URL=http://localhost:8000

# Fase 1 em diante:
# JWT_SECRET=
# Fase 2 em diante (embeddings):
# OPENAI_API_KEY=
# Fase 3 em diante (LLM): anthropic | openai
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
